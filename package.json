{
  "name": "routier",
  "version": "0.2.0",
  "description": "Static route scanner for Next.js and GraphQL that generates OpenAPI, Postman and Insomnia collections",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "routier": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "nextjs",
    "graphql",
    "openapi",
    "postman",
    "insomnia",
    "api",
    "routes",
    "scanner",
    "zod"
  ],
  "author": "Matias Arenas (FHX23)",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/FHX23/Routier.git"
  },
  "bugs": {
    "url": "https://github.com/FHX23/Routier/issues"
  },
  "homepage": "https://github.com/FHX23/Routier#readme",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "graphql": "^17.0.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
